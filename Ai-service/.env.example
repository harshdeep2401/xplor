# Copy to `.env` and fill in FASTAPI_SECRET. NEVER commit the real .env.

# --- Security ---
# Shared secret with the Node server: must be IDENTICAL to FASTAPI_SECRET in
# server/.env, and at least 32 characters. Without it every detection request
# is refused. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
FASTAPI_SECRET=
# Interactive API docs at /docs. Set to false when exposing the service
# through a tunnel (compose.host.yml does this for you).
ENABLE_DOCS=true

# --- Tunnel (only for compose.host.yml; see docs/guides/ai-hosting.md) ---
# quick-tunnel = temporary *.trycloudflare.com URL, changes on every restart
# named-tunnel = fixed URL on your own domain, needs TUNNEL_TOKEN
COMPOSE_PROFILES=quick-tunnel
TUNNEL_TOKEN=

# --- Detector ---
# unet   = the trained floor-plan model (Model/best.pt). If it can't load, the
#          service answers 503 "unavailable"; it never falls back silently.
# opencv = the old heuristic, only for comparison runs.
DETECTOR=unet
# Weights file, relative to Ai-service/. Get best.pt from the project lead.
MODEL_PATH=Model/best.pt
# auto = NVIDIA GPU if PyTorch can see one, otherwise CPU (slower: ~1 s/plan).
MODEL_DEVICE=auto
# Masks are vectorized at the image's size, capped at this long side (px).
MAX_VECTORIZE_SIDE=2048

# --- System Status page ---
# Machine name the server's System Status page shows for the AI service.
# Empty = this computer's name.
HOST_LABEL=

# --- Upload limits ---
MAX_IMAGE_BYTES=20971520
# Images above this many pixels are rejected (decompression-bomb guard).
MAX_IMAGE_PIXELS=50000000

# --- OpenCV heuristic tuning (DETECTOR=opencv only) ---
MIN_WALL_LENGTH_PX=40
MIN_ROOM_AREA_PX=4000
