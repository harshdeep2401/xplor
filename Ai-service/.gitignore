.env
.env.*
!.env.example

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python bytecode / cache ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
.eggs/

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- Jupyter (if notebooks get used for model experimentation) ---
.ipynb_checkpoints/

