# classical-CV stub — add a proper artifact/LFS strategy instead.
*.pt
*.pth
*.onnx
*.h5
*.weights
models/*.bin

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editor/IDE ---
.vscode/
.idea/

# --- Logs ---
*.log