# Copy to `.env` and fill in. NEVER commit the real .env.
# Every variable is checked at start-up (config/env.ts): a missing or malformed
# value stops the server with a message naming it. Blank = unset (default used).

# development | test | production. Production also requires a 32+ character
# JWT_SECRET, FASTAPI_SECRET, and no "*" in CORS_ORIGINS.
NODE_ENV=development

# --- Server ---
PORT=5001
# Comma-separated allow-list of frontend origins (no wildcard in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Auth ---
# Signs login tokens. Use 32+ random characters (required in production):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# --- Firebase Admin (Google sign-in) ---
# From the Firebase service-account JSON. Leave blank to switch Google sign-in
# off; everything else works without it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with 
 for the line breaks.
FIREBASE_PRIVATE_KEY=

# --- GLB export ---
# How many most-recent GLB exports to keep per project (older ones are pruned).
GLB_KEEP=2

# --- AI service (FastAPI) ---
# Full endpoint including path. Local: the uvicorn dev server. When the AI
# service is hosted through the tunnel: https://<tunnel-host>/process-floor-plan
# (docs/guides/ai-hosting.md).
FASTAPI_WEBHOOK_URL=http://127.0.0.1:8000/process-floor-plan
# Shared secret, sent as "Authorization: Bearer ..." on every call. Must be
# IDENTICAL to FASTAPI_SECRET in Ai-service/.env, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FASTAPI_SECRET=
# How long to wait for a detection (ms). Raise it if the tunnel is slow.
AI_SERVICE_TIMEOUT_MS=30000

# --- Furniture suggestions ---
# Which recommender to use (services/recommender). Blank = rules-v1.
RECOMMENDER=

# --- Blob storage (Cloudflare R2 / S3) — used once storage moves off local disk ---
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
